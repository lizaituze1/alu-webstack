#!/usr/bin/env bash
# Displays information about subdomains of a domain (record type and destination)

display_info() {
    local domain="$1"
    local sub="$2"
    dig "$sub.$domain" | grep -A1 'ANSWER SECTION:' | awk -v s="$sub" 'NR==2 {print "The subdomain " s " is a " $4 " record and points to " $5}'
}

if [ "$#" -eq 1 ]; then
    for sub in www lb-01 web-01 web-02; do
        display_info "$1" "$sub"
    done
else
    display_info "$1" "$2"
fi
